# Server-only. Never prefix these with VITE_ or commit real values.
SOLARI_API_KEY=
SOLARI_SANDBOX_TEMPLATE=base
SOLARI_EVALUATION_TOKEN=

# Leave false on unattended public deployments. Enabling also requires the
# separate admission token above; it is not the Solari API key.
SOLARI_EVALUATION_ENABLED=false

# Hosted remote MCP practice. Keep false until durable public admission/rate
# limits are configured. The ticket secret must be a random 32+ character
# server-only value. Neither value is qualification authority.
SOLARI_REMOTE_ENABLED=false
SOLARI_REMOTE_TICKET_SECRET=
SOLARI_REMOTE_ALLOWED_HOSTS=solari-agent-arena.vercel.app,localhost,127.0.0.1

# Durable anonymous admission. The Upstash Marketplace injects Redis as either
# the UPSTASH_* pair or Vercel's KV_* aliases. Configure one pair, never both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# QStash credentials are always server-only.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
SOLARI_REMOTE_REDIS_SCOPE=production
SOLARI_REMOTE_MAX_CONCURRENT=2
SOLARI_REMOTE_MAX_IP_CONCURRENT=1
SOLARI_REMOTE_DAILY_LIMIT=20
SOLARI_REMOTE_HOLDER_DAILY_LIMIT=2
SOLARI_REMOTE_IP_DAILY_LIMIT=2
