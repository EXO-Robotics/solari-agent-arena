{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/evaluate.mjs": {
      "includeFiles": "{package-lock.json,server/runner/**,server/lib/**,src/model/h1-sagittal.xml}",
      "maxDuration": 120
    },
    "api/agent-evaluate.mjs": {
      "includeFiles": "{package-lock.json,server/runner/**,server/lib/**,src/model/h1-sagittal.xml,src/agent/course.json}",
      "maxDuration": 120
    },
    "api/arena-ticket.mjs": {
      "includeFiles": "{package-lock.json,server/lib/**,src/agent/course-registry.json}",
      "maxDuration": 120
    },
    "api/arena-command.mjs": {
      "includeFiles": "{package-lock.json,server/lib/**,src/agent/course-registry.json}",
      "maxDuration": 120
    },
    "api/arena-expire.mjs": {
      "includeFiles": "{package-lock.json,server/lib/**}",
      "maxDuration": 60
    },
    "api/mcp.mjs": {
      "includeFiles": "{package-lock.json,server/lib/**,src/agent/course-registry.json}",
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/api/evaluate", "destination": "/api/evaluate.mjs" },
    { "source": "/api/agent-evaluate", "destination": "/api/agent-evaluate.mjs" },
    { "source": "/api/arena-ticket", "destination": "/api/arena-ticket.mjs" },
    { "source": "/api/arena-command", "destination": "/api/arena-command.mjs" },
    { "source": "/api/arena-expire", "destination": "/api/arena-expire.mjs" },
    { "source": "/mcp", "destination": "/api/mcp.mjs" }
  ]
}
